  "cards": [
    {
      "dot": "emerald",
      "title": "Stream Column (Immutable Truth)",
      "items": [
        "stream_events is the single append-only source of truth keyed by ULID and monotonic seq",
        "fallback_blobs stores content-addressed artifacts referenced via n1://fallback/<sha256>"
      ]
    },
    {
      "dot": "amber",
      "title": "Memory & Scrum Columns (Derived & Mirrored)",
      "items": [
        "lessons, directives, and issues are pure deterministic folds of stream_events",
        "sync_ledger maps local ULIDs to Directory, GitHub Projects v2, and Jira IDs without mutating hashes"
      ]
    }
  ]
