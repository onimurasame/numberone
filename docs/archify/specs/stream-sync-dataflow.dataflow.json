      "dot": "rose",
      "title": "Redaction Before Persistence",
      "items": [
        "Sensitive files (.env*, *.pem, *.key) never snapshot raw content",
        "Tokens inside logs or chat transcripts are scrubbed before SHA-256 hashing"
      ]
    },
    {
      "dot": "cyan",
      "title": "Lossless Fallback Guarantee",
      "items": [
        "Fields exceeding GitHub or Jira limits remain addressable via n1://fallback/<sha256>",
        "Event hashes exclude mutable remote IDs, keeping historical chain immutable"
