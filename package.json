{
  "name": "numberone",
  "version": "1.0.0",
  "description": "Harness-agnostic, event-sourced authoritative workspace curator and System of Record (SoR) with BMAD Party Mode bridge crew and KPI-proven continuous self-evolution.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "numberone": "dist/cli.js",
    "n1": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onimurasame/numberone.git"
  },
  "homepage": "https://onimurasame.github.io/numberone/",
  "bugs": {
    "url": "https://github.com/onimurasame/numberone/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(fs => fs.chmodSync('dist/cli.js', 0o755))\"",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "pr:triage": "node scripts/pr-automation.mjs sweep --dry-run --verify-remote-tags",
    "pr:merge": "node scripts/pr-automation.mjs sweep --apply --verify-remote-tags",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai-agent",
    "event-sourcing",
    "mcp",
    "system-of-record",
    "bmad",
    "party-mode",
    "continuous-delivery",
    "devsecops",
    "infrastructure",
    "harness-agnostic"
  ],
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
